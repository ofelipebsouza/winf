{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user profile in the application.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "User's email address" },
        "name": { "type": "string", "description": "User's full name" },
        "role": { "type": "string", "enum": ["admin", "investor"], "description": "Role of the user" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" },
        "updatedAt": { "type": "number", "description": "Timestamp of last update" }
      },
      "required": ["email", "name", "role", "createdAt", "updatedAt"]
    },
    "Investment": {
      "title": "Investment",
      "description": "An investment record in the Dark Pool.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "ID of the user who made the investment" },
        "poolId": { "type": "string", "description": "ID of the Dark Pool" },
        "amount": { "type": "number", "description": "Investment amount" },
        "status": { "type": "string", "enum": ["pending", "active", "completed"], "description": "Status of the investment" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" },
        "updatedAt": { "type": "number", "description": "Timestamp of last update" }
      },
      "required": ["userId", "poolId", "amount", "status", "createdAt", "updatedAt"]
    },
    "Dividend": {
      "title": "Dividend",
      "description": "A dividend payout record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "ID of the user receiving the dividend" },
        "investmentId": { "type": "string", "description": "ID of the associated investment" },
        "amount": { "type": "number", "description": "Dividend amount" },
        "status": { "type": "string", "enum": ["pending", "processed"], "description": "Status of the dividend payout" },
        "date": { "type": "string", "description": "Payout date (e.g., '12 Mai 2026')" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" },
        "updatedAt": { "type": "number", "description": "Timestamp of last update" }
      },
      "required": ["userId", "investmentId", "amount", "status", "date", "createdAt", "updatedAt"]
    },
    "AgentInsight": {
      "title": "Agent Insight",
      "description": "Insights and alerts generated by WINF AI for users.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "related_entity_id": { "type": "string" },
        "is_read": { "type": "boolean" },
        "created_at": { "type": "timestamp" }
      },
      "required": ["user_id", "type", "title", "content", "is_read", "created_at"]
    },
    "CoreAIChat": {
      "title": "Core AI Chat",
      "description": "Message history for the Core AI interface.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "ai", "system"] },
        "text": { "type": "string" },
        "created_at": { "type": "timestamp" }
      },
      "required": ["user_id", "role", "text", "created_at"]
    },
    "AIGeneration": {
      "title": "AI Generation",
      "description": "Tracks AI generated content like marketing copy.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "tool_used": { "type": "string" },
        "prompt": { "type": "string" },
        "output_url": { "type": "string" },
        "media_type": { "type": "string" },
        "content": { "type": "string" },
        "created_at": { "type": "timestamp" }
      },
      "required": ["user_id", "tool_used", "prompt", "media_type", "created_at"]
    },
    "AgentLog": {
      "title": "Agent Log",
      "description": "Logs for Agent/Lead interactions and automation streams.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "agentType": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "created_at": { "type": "timestamp" }
      },
      "required": ["user_id", "agentType", "action", "created_at"]
    },
    "DocVault": {
      "title": "DocVault",
      "description": "Metadata for executive assets and PDF brochures.",
      "type": "object",
      "properties": {
        "fileName": { "type": "string", "description": "The exact physical file name" },
        "title": { "type": "string", "description": "Human readable name on screen" },
        "category": { "type": "string", "description": "Asset category, such as Alpha / Kiosk / Beta / Gamma" },
        "description": { "type": "string", "description": "Description of the document contents" },
        "fileSize": { "type": "string", "description": "Size of the file" },
        "url": { "type": "string", "description": "Secure download url for the file" },
        "allowedRoles": { "type": "array", "description": "Allowed roles to download this file" },
        "created_at": { "type": "timestamp", "description": "Timestamp of creation" }
      },
      "required": ["fileName", "title", "category", "description", "url", "allowedRoles", "created_at"]
    },
    "DocSignature": {
      "title": "Document Signature",
      "description": "Electronic signature record for official documents.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "ID of the user who signed" },
        "userEmail": { "type": "string", "description": "Email of the signer" },
        "userName": { "type": "string", "description": "Legal Name of the signer" },
        "userCPF": { "type": "string", "description": "CPF of the signer" },
        "docId": { "type": "string", "description": "ID of the document signed" },
        "docName": { "type": "string", "description": "Name of the signed document" },
        "biometricHash": { "type": "string", "description": "Hash of biometric confirmation" },
        "signedAt": { "type": "timestamp", "description": "Timestamp of signature" }
      },
      "required": ["userId", "userEmail", "userName", "userCPF", "docId", "docName", "signedAt"]
    },
    "AuronKnowledge": {
      "title": "W-NO Knowledge",
      "description": "Knowledge and instructions stored or learned by W-NO AI.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "topic": { "type": "string" },
        "source": { "type": "string", "enum": ["MANUAL", "AUTO_CONVERSATION", "SYSTEM"] },
        "content": { "type": "string" },
        "confidence": { "type": "number" },
        "status": { "type": "string", "enum": ["APPROVED", "PENDING", "REJECTED"] },
        "conversation_snippet": { "type": "string" },
        "created_at": { "type": "timestamp" }
      },
      "required": ["user_id", "topic", "source", "content", "confidence", "status", "created_at"]
    },
    "Unidade": {
      "title": "Unidade",
      "description": "A licensed franchisee unit in the WINF/AeroCore network.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "partnerEmail": { "type": "string" },
        "walletM2": { "type": "number", "description": "Consolidated square meters balance" },
        "warningsCount": { "type": "number", "description": "Weekly warnings for exceeding tolerances" },
        "status": { "type": "string", "enum": ["NORMAL", "REPOSICAO", "AUDITORIA", "BLOQUEADO"] },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["id", "name", "partnerEmail", "walletM2", "warningsCount", "status", "createdAt", "updatedAt"]
    },
    "OrdemServico": {
      "title": "Ordem de Serviço",
      "description": "Operational service order recording window film applications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "unidadeId": { "type": "string" },
        "user_id": { "type": "string" },
        "areaTeoricaM2": { "type": "number" },
        "actualM2": { "type": "number" },
        "metodoCorte": { "type": "string", "enum": ["DIGITAL_PLOTTER", "MANUAL_LINEAR"] },
        "nivelComplexidade": { "type": "string", "enum": ["ARQUITETONICO_PLANO", "AUTOMOTIVO_PADRAO", "AUTOMOTIVO_COMPLEXO"] },
        "justification": { "type": "string" },
        "status": { "type": "string", "enum": ["SEALED", "EXCEPTION"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["id", "unidadeId", "user_id", "areaTeoricaM2", "actualM2", "metodoCorte", "nivelComplexidade", "status", "createdAt"]
    },
    "LedgerTransacao": {
      "title": "Token Ledger Transaction",
      "description": "Immutable ledger tracking square meter balance movements.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "unidadeId": { "type": "string" },
        "user_id": { "type": "string" },
        "hash": { "type": "string" },
        "type": { "type": "string", "enum": ["B2B_INFLOW", "OS_SETTLE", "ADJUSTMENT"] },
        "m2Change": { "type": "number" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["SEALED", "EXCEPTION"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["id", "unidadeId", "user_id", "hash", "type", "m2Change", "details", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "/investments/{investmentId}": {
      "schema": { "$ref": "#/entities/Investment" },
      "description": "Stores investment records."
    },
    "/dividends/{dividendId}": {
      "schema": { "$ref": "#/entities/Dividend" },
      "description": "Stores dividend payout records."
    },
    "/agent_insights/{insightId}": {
      "schema": { "$ref": "#/entities/AgentInsight" },
      "description": "Stores AI generated insights and alerts."
    },
    "/core_ai_chats/{chatId}": {
      "schema": { "$ref": "#/entities/CoreAIChat" },
      "description": "Stores AI chat history."
    },
    "/ai_generations/{genId}": {
      "schema": { "$ref": "#/entities/AIGeneration" },
      "description": "Stores AI generation outputs."
    },
    "/agent_logs/{logId}": {
      "schema": { "$ref": "#/entities/AgentLog" },
      "description": "Stores AI automation and interaction logs."
    },
    "/doc_vault/{docId}": {
      "schema": { "$ref": "#/entities/DocVault" },
      "description": "Stores secure document metadata."
    },
    "/doc_signatures/{sigId}": {
      "schema": { "$ref": "#/entities/DocSignature" },
      "description": "Stores user digital signatures for official legal documents."
    },
    "/auron_knowledge/{knowledgeId}": {
      "schema": { "$ref": "#/entities/AuronKnowledge" },
      "description": "Stores W-NO AI lessons and knowledge bases."
    },
    "/unidades/{unidadeId}": {
      "schema": { "$ref": "#/entities/Unidade" },
      "description": "FRANQUIAS - Saldo consolidado M2 e credenciais."
    },
    "/ordens_servico/{osId}": {
      "schema": { "$ref": "#/entities/OrdemServico" },
      "description": "CORE OS - Consumo teórico, consumo real e limites controlados pelo motor Precision."
    },
    "/ledger_transacoes/{txId}": {
      "schema": { "$ref": "#/entities/LedgerTransacao" },
      "description": "LIVRO-RAZÃO IMUTÁVEL - Histórico exaustivo de mutação das bobinas."
    }
  }
}
